  "fonts": {
    "display": "Bricolage Grotesque",
    "meta": "DM Mono",
    "devanagari": "Tiro Devanagari Hindi"
  },
  "allowedFamilies": [
    "Bricolage Grotesque",
    "DM Mono",
    "Tiro Devanagari Hindi",
    "Tiro Devanagari Sanskrit",
    "monospace",
    "sans-serif",
    "serif",
    "inherit"
