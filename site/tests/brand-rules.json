{
  "_note": "Brand guideline as the tests enforce it. Source: brand/brand_book.html, direction B 'sketchbook riso' (owner pick 2026-10-14). Edit here, not in the test code.",
  "palette": {
    "paper": "#F1E9D2",
    "ink": "#0A0618",
    "riso blue": "#2E3BDB",
    "riso pink": "#E0368F",
    "spiral": "#F6E27A",
    "indigo": "#2A1A9E",
    "red": "#FF2E4A",
    "white": "#FBF8E8",
    "deep": "#140B52",
