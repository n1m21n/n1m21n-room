    "DU",
    "AAC",
    "EP",
    "LP",
    "ID",
    "AI",
    "3D",
    "2D",
    "II",
    "III"
  ],
  "allowedGlyphs": "♪♫☞↗→←↑↓·…—–•✕×‹›⏸▶❚",
